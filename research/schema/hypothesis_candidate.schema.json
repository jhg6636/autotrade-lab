{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jhg6636/autotrade-lab/schema/hypothesis_candidate.schema.json",
  "title": "Staging hypothesis candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis_id", "source_ids", "canonical_name", "family", "markets", "asset_direction", "execution_scope", "applications", "timeframes", "hypothesis", "entry_rule", "exit_rule", "sizing_rule", "required_data", "ambiguities", "status"],
  "properties": {
    "hypothesis_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "canonical_name": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "markets": {"type": "array", "minItems": 1, "items": {"enum": ["kr_equity", "kr_etf", "crypto_spot", "crypto_perp", "us_equity", "multi_asset"]}},
    "asset_direction": {"enum": ["long_only", "long_short", "delta_neutral", "market_making", "directionless", "mixed"]},
    "execution_scope": {"enum": ["executable", "context_only"]},
    "applications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/application"}},
    "timeframes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hypothesis": {"type": "string", "minLength": 1},
    "entry_rule": {"type": "string", "minLength": 1},
    "exit_rule": {"type": "string", "minLength": 1},
    "sizing_rule": {"type": "string", "minLength": 1},
    "required_data": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "execution_assumptions": {"type": "array", "items": {"type": "string"}},
    "ambiguities": {"type": "array", "items": {"type": "string"}},
    "claimed_results": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["usable", "incomplete", "inaccessible"]}
  },
  "$defs": {
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["market", "asset_direction", "execution_scope", "target_exposure"],
      "properties": {
        "market": {"enum": ["kr_equity", "kr_etf", "crypto_spot", "crypto_perp", "us_equity", "multi_asset"]},
        "asset_direction": {"enum": ["long_only", "long_short", "delta_neutral", "market_making", "directionless"]},
        "execution_scope": {"enum": ["executable", "context_only"]},
        "target_exposure": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "number", "minimum": -1, "maximum": 1}, "maximum": {"type": "number", "minimum": -1, "maximum": 1}}}
      }
    }
  }
}
